<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Configuracion base del proyecto web. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Modelos comparte formularios y entidades con la aplicacion web. -->
  <ItemGroup>
    <ProjectReference Include="..\Carniceria.Modelos\Carniceria.Modelos.csproj" />
  </ItemGroup>

  <!-- Directorios reservados para vistas y recursos estaticos. -->
  <ItemGroup>
    <Folder Include="Models\" />
    <Folder Include="wwwroot\lib\" />
  </ItemGroup>

</Project>
