@* Define navegación, contenido principal y recursos comunes del sitio. *@
<!DOCTYPE html>
<html lang="es-CR">
@* Metadatos del documento y hojas de estilo compartidas. *@
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Carnicería</title>
    <link rel="icon" type="image/png" href="~/favicon.png" asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>
<body>
    <a class="saltar-contenido" href="#contenido-principal">
        Ir al contenido principal
    </a>

    <header class="encabezado-sitio">
        <div class="contenedor">
            <a class="marca"
               asp-area=""
               asp-controller="Home"
               asp-action="Index">
                Carnicería
            </a>

            @* Enlaces principales a los módulos de la aplicación. *@
            <nav class="navegacion-principal"
                 aria-label="Navegación principal">
                <ul class="menu-principal">
                    <li>
                        <a asp-area=""
                           asp-controller="Home"
                           asp-action="Index">
                            Inicio
                        </a>
                    </li>
                    <li>
                        <a asp-area=""
                           asp-controller="Clientes"
                           asp-action="Index">
                            Clientes
                        </a>
                    </li>
                    <li>
                        <a asp-area=""
                           asp-controller="Empleados"
                           asp-action="Index">
                            Empleados
                        </a>
                    </li>
                    <li>
                        <a asp-area=""
                           asp-controller="Productos"
                           asp-action="Index">
                            Inventario de Productos
                        </a>
                    </li>
                    <li>
                        <a asp-area=""
                           asp-controller="Proveedores"
                           asp-action="Index">
                            Proveedores
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </header>

    @* Área central donde se renderiza cada página. *@
    <main id="contenido-principal"
          class="contenedor contenido-principal"
          tabindex="-1">
        <partial name="_Mensajes" />

        @RenderBody()
    </main>

    @* Pie común con el año de presentación. *@
    <footer class="pie-sitio">
        <div class="contenedor">
            <p>&copy; @DateTime.Now.Year Carnicería</p>
        </div>
    </footer>

    @* Carga la inicialización compartida de las vistas. *@
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
