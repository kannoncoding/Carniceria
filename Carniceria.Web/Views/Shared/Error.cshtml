@model ErrorViewModel
@* Muestra el error y ofrece una ruta de regreso al modulo. *@

@{
    ViewData["Title"] = Model.Titulo;
}

<h1>@Model.Titulo</h1>

<div class="mensaje mensaje-error" role="alert">
    <p>@Model.Mensaje</p>
</div>

@if (Model.ShowRequestId)
{
    <p class="ayuda-campo">
        Referencia de la solicitud:
        <code>@Model.RequestId</code>
    </p>
}

<div class="acciones">
    <a class="boton"
       asp-area=""
       asp-controller="@Model.ControladorRegreso"
       asp-action="Index"
       asp-route-id="">
        @Model.TextoRegreso
    </a>

    @if (Model.ControladorRegreso != "Home")
    {
        <a class="boton boton-secundario"
           asp-area=""
           asp-controller="Home"
           asp-action="Index"
           asp-route-id="">
            Volver al inicio
        </a>
    }
</div>