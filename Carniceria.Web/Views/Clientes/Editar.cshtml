@model ClienteFormulario

@{
    ViewData["Title"] = "Editar cliente";

    string? idCliente = ViewContext.RouteData.Values["id"]?.ToString();
}

<h1>Editar cliente</h1>

<p>
    Actualice los datos del cliente. Todos los campos son obligatorios.
</p>

<form asp-area=""
      asp-controller="Clientes"
      asp-action="Editar"
      asp-route-id="@idCliente"
      method="post"
      asp-antiforgery="true"
      class="formulario"
      novalidate>

    <partial name="_ResumenValidacion" />

    <partial name="_Formulario" model="@Model" />

    <div class="acciones">
        <button type="submit" class="boton">
            Guardar cambios
        </button>

        <a class="boton boton-secundario"
           asp-area=""
           asp-controller="Clientes"
           asp-action="Detalles"
           asp-route-id="@idCliente">
            Cancelar
        </a>
    </div>
</form>