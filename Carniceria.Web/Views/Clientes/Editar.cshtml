@model ClienteFormulario
@* Envia los cambios del cliente asociado al Id de la ruta. *@

@{
    ViewData["Title"] = "Editar cliente";

    string? idCliente = ViewContext.RouteData.Values["id"]?.ToString();
}

<h1>Editar cliente</h1>

<p>
    Actualice los datos del cliente. Todos los campos son obligatorios.
</p>

@* Envia los cambios junto con el Id de la ruta y proteccion antifalsificacion. *@
<form asp-area=""
      asp-controller="Clientes"
      asp-action="Editar"
      asp-route-id="@idCliente"
      method="post"
      asp-antiforgery="true"
      class="formulario"
      novalidate>

    @* Muestra los errores antes de los campos editables. *@
    <partial name="_ResumenValidacion" />

    @* Reutiliza los campos compartidos del cliente. *@
    <partial name="_Formulario" model="@Model" />

    @* Acciones para guardar o cancelar la edicion. *@
    <div class="acciones">
        <button type="submit" class="boton">
            Guardar cambios
        </button>

        <a class="boton boton-secundario"
           asp-area=""
           asp-controller="Clientes"
           asp-action="Detalles"
           asp-route-id="@idCliente">
            Cancelar
        </a>
    </div>
</form>
