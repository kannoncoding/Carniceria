@model RespuestaCliente
@* Muestra los datos del cliente antes de confirmar su eliminacion. *@

@{
    ViewData["Title"] = "Eliminar cliente";
}

<h1>Eliminar cliente</h1>

<partial name="_ResumenValidacion" />

@* Resume la consecuencia antes de confirmar la operacion. *@
<div class="mensaje mensaje-advertencia">
    <p>
        <strong>¿Desea eliminar este cliente?</strong>
    </p>

    <p>
        Revise la información antes de confirmar.
        Esta acción no se puede deshacer.
    </p>
</div>

@* Datos usados para identificar al cliente que se eliminara. *@
<dl class="detalle-registro">
    <div>
        <dt>Tipo de identificación</dt>
        <dd>
            @Html.DisplayFor(model => model.TipoIdentificacion)
        </dd>
    </div>

    <div>
        <dt>Identificación</dt>
        <dd>@Model.Identificacion</dd>
    </div>

    <div>
        <dt>Nombre completo</dt>
        <dd>
            @Model.Nombre @Model.PrimerApellido @Model.SegundoApellido
        </dd>
    </div>

    <div>
        <dt>Fecha de nacimiento</dt>
        <dd>@Model.FechaNacimiento.ToString("dd/MM/yyyy")</dd>
    </div>
</dl>

@* Envia la confirmacion mediante POST protegido contra falsificacion. *@
<form asp-area=""
      asp-controller="Clientes"
      asp-action="EliminarConfirmado"
      asp-route-id="@Model.Id"
      method="post"
      asp-antiforgery="true">

    <div class="acciones">
        <button type="submit" class="boton boton-peligro">
            Confirmar eliminación
        </button>

        <a class="boton boton-secundario"
           asp-area=""
           asp-controller="Clientes"
           asp-action="Index"
           asp-route-id="">
            Cancelar
        </a>
    </div>
</form>
