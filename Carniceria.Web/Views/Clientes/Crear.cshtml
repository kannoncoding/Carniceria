@model ClienteFormulario
@* Envia los datos del nuevo cliente al controlador. *@

@{
    ViewData["Title"] = "Registrar cliente";
}

<h1>Registrar cliente</h1>

<p>
    Complete los datos del cliente. Todos los campos son obligatorios.
</p>

@* Envia el formulario con proteccion antifalsificacion. *@
<form asp-area=""
      asp-controller="Clientes"
      asp-action="Crear"
      asp-route-id=""
      method="post"
      asp-antiforgery="true"
      class="formulario"
      novalidate>

    @* Muestra los errores antes de los campos editables. *@
    <partial name="_ResumenValidacion" />

    @* Reutiliza los campos compartidos del cliente. *@
    <partial name="_Formulario" model="@Model" />

    @* Acciones para guardar o cancelar el alta. *@
    <div class="acciones">
        <button type="submit" class="boton">
            Guardar cliente
        </button>

        <a class="boton boton-secundario"
           asp-area=""
           asp-controller="Clientes"
           asp-action="Index"
           asp-route-id="">
            Cancelar
        </a>
    </div>
</form>
