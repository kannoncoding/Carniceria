@model IReadOnlyList<RespuestaCliente>
@* Lista clientes y enlaza con sus operaciones disponibles. *@

@{
    ViewData["Title"] = "Clientes";
}

<h1>Clientes</h1>

@* Enlaces para registrar y buscar clientes. *@
<div class="acciones">
    <a class="boton"
       asp-area=""
       asp-controller="Clientes"
       asp-action="Crear"
       asp-route-id="">
        Registrar cliente
    </a>

    <a class="boton boton-secundario"
       asp-area=""
       asp-controller="Clientes"
       asp-action="Buscar"
       asp-route-id="">
        Buscar clientes
    </a>
</div>

@* Alterna entre el estado vacio y la tabla de clientes. *@
@if (Model.Count == 0)
{
    <p class="estado-vacio">
        Todavía no hay clientes registrados.
    </p>
}
else
{
    <p>
        Total de clientes registrados:
        <strong>@Model.Count</strong>
    </p>

    @* Tabla con clientes y acciones por registro. *@
    <div class="tabla-contenedor"
         role="region"
         aria-label="Listado de clientes"
         tabindex="0">
        <table>
            <thead>
                <tr>
                    <th scope="col">Tipo de identificación</th>
                    <th scope="col">Identificación</th>
                    <th scope="col">Nombre</th>
                    <th scope="col">Primer apellido</th>
                    <th scope="col">Segundo apellido</th>
                    <th scope="col">Fecha de nacimiento</th>
                    <th scope="col">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @* Renderiza una fila por cliente registrado. *@
                @foreach (var cliente in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => cliente.TipoIdentificacion)
                        </td>
                        <td>@cliente.Identificacion</td>
                        <td>@cliente.Nombre</td>
                        <td>@cliente.PrimerApellido</td>
                        <td>@cliente.SegundoApellido</td>
                        <td>
                            @cliente.FechaNacimiento.ToString("dd/MM/yyyy")
                        </td>
                        <td>
                            <div class="acciones">
                                <a class="boton boton-secundario"
                                   asp-area=""
                                   asp-controller="Clientes"
                                   asp-action="Detalles"
                                   asp-route-id="@cliente.Id"
                                   aria-label="Ver detalles del cliente @cliente.Identificacion">
                                    Ver detalles
                                </a>

                                <a class="boton boton-secundario"
                                   asp-area=""
                                   asp-controller="Clientes"
                                   asp-action="Editar"
                                   asp-route-id="@cliente.Id"
                                   aria-label="Editar el cliente @cliente.Identificacion">
                                    Editar
                                </a>

                                <a class="boton boton-peligro"
                                   asp-area=""
                                   asp-controller="Clientes"
                                   asp-action="Eliminar"
                                   asp-route-id="@cliente.Id"
                                   aria-label="Eliminar el cliente @cliente.Identificacion">
                                    Eliminar
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
