@model BusquedaViewModel<Empleado>

@{
    ViewData["Title"] = "Buscar empleados";
}

<h1>Buscar empleados</h1>

<p>
    Busque un empleado mediante su identificación completa.
</p>

<form asp-area=""
      asp-controller="Empleados"
      asp-action="Buscar"
      asp-route-id=""
      method="get"
      asp-antiforgery="false"
      class="formulario"
      novalidate>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" role="alert">
            <p>
                No se pudo realizar la búsqueda.
                Revise los siguientes errores:
            </p>
        </div>
    }

    <div class="campo">
        <label asp-for="Consulta">Identificación</label>

        <input asp-for="Consulta"
               name="consulta"
               type="search"
               class="control"
               autocomplete="off"
               spellcheck="false"
               required
               aria-describedby="ayuda-consulta error-consulta" />

        <span id="ayuda-consulta" class="ayuda-campo">
            Ingrese la cédula nacional completa con sus guiones
            o los 12 dígitos del DIMEX.
        </span>

        <span asp-validation-for="Consulta"
              id="error-consulta"></span>
    </div>

    <div class="acciones">
        <button type="submit" class="boton">
            Buscar
        </button>

        <a class="boton boton-secundario"
           asp-area=""
           asp-controller="Empleados"
           asp-action="Buscar"
           asp-route-id=""
           asp-route-consulta="">
            Limpiar búsqueda
        </a>

        <a class="boton boton-secundario"
           asp-area=""
           asp-controller="Empleados"
           asp-action="Index"
           asp-route-id="">
            Volver a Empleados
        </a>
    </div>
</form>

@if (!Model.BusquedaRealizada && ViewData.ModelState.IsValid)
{
    <p class="estado-vacio">
        Ingrese una identificación y presione Buscar para consultar
        los empleados registrados.
    </p>
}
else if (Model.BusquedaRealizada && Model.Resultados.Count == 0)
{
    <p class="estado-vacio" role="status">
        No se encontraron empleados con la identificación
        <strong>@Model.Consulta</strong>.
    </p>
}
else if (Model.BusquedaRealizada)
{
    <h2>Resultados de la búsqueda</h2>

    <p>
        Identificación consultada:
        <strong>@Model.Consulta</strong>.
        Empleados encontrados:
        <strong>@Model.Resultados.Count</strong>.
    </p>

    <div class="tabla-contenedor"
         role="region"
         aria-label="Resultados de la búsqueda de empleados"
         tabindex="0">
        <table>
            <thead>
                <tr>
                    <th scope="col">Identificación</th>
                    <th scope="col">Nombre completo</th>
                    <th scope="col">Área de trabajo</th>
                    <th scope="col">Puesto</th>
                    <th scope="col">Turno</th>
                    <th scope="col">Salario mensual</th>
                    <th scope="col">Fecha de ingreso</th>
                    <th scope="col">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var empleado in Model.Resultados)
                {
                    <tr>
                        <td>@empleado.Identificacion</td>
                        <td>
                            @empleado.Nombre
                            @empleado.PrimerApellido
                            @empleado.SegundoApellido
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => empleado.AreaTrabajo)
                        </td>
                        <td>@empleado.Puesto</td>
                        <td>
                            @Html.DisplayFor(modelItem => empleado.Turno)
                        </td>
                        <td>
                            ₡@empleado.SalarioMensual.ToString("N2")
                        </td>
                        <td>
                            @empleado.FechaIngreso.ToString("dd/MM/yyyy")
                        </td>
                        <td>
                            <div class="acciones">
                                <a class="boton boton-secundario"
                                   asp-area=""
                                   asp-controller="Empleados"
                                   asp-action="Detalles"
                                   asp-route-id="@empleado.Id"
                                   aria-label="Ver detalles del empleado @empleado.Identificacion">
                                    Ver detalles
                                </a>

                                <a class="boton boton-secundario"
                                   asp-area=""
                                   asp-controller="Empleados"
                                   asp-action="Editar"
                                   asp-route-id="@empleado.Id"
                                   aria-label="Editar el empleado @empleado.Identificacion">
                                    Editar
                                </a>

                                <a class="boton boton-peligro"
                                   asp-area=""
                                   asp-controller="Empleados"
                                   asp-action="Eliminar"
                                   asp-route-id="@empleado.Id"
                                   aria-label="Eliminar el empleado @empleado.Identificacion">
                                    Eliminar
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}