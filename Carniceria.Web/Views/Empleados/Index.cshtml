@model IReadOnlyList<Empleado>
@* Lista empleados y enlaza con sus operaciones disponibles. *@

@{
    ViewData["Title"] = "Empleados";
}

<h1>Empleados</h1>

@* Enlaces para registrar y buscar empleados. *@
<div class="acciones">
    <a class="boton"
       asp-area=""
       asp-controller="Empleados"
       asp-action="Crear"
       asp-route-id="">
        Registrar empleado
    </a>

    <a class="boton boton-secundario"
       asp-area=""
       asp-controller="Empleados"
       asp-action="Buscar"
       asp-route-id="">
        Buscar empleados
    </a>
</div>

@* Alterna entre el estado vacío y la tabla de empleados. *@
@if (Model.Count == 0)
{
    <p class="estado-vacio">
        Todavía no hay empleados registrados.
    </p>
}
else
{
    <p>
        Total de empleados registrados:
        <strong>@Model.Count</strong>
    </p>

    @* Tabla con empleados y acciones por registro. *@
    <div class="tabla-contenedor"
         role="region"
         aria-label="Listado de empleados"
         tabindex="0">
        <table>
            <thead>
                <tr>
                    <th scope="col">Identificación</th>
                    <th scope="col">Nombre completo</th>
                    <th scope="col">Área de trabajo</th>
                    <th scope="col">Puesto</th>
                    <th scope="col">Turno</th>
                    <th scope="col">Salario mensual</th>
                    <th scope="col">Fecha de ingreso</th>
                    <th scope="col">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @* Renderiza una fila por empleado registrado. *@
                @foreach (var empleado in Model)
                {
                    <tr>
                        <td>@empleado.Identificacion</td>
                        <td>
                            @empleado.Nombre
                            @empleado.PrimerApellido
                            @empleado.SegundoApellido
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => empleado.AreaTrabajo)
                        </td>
                        <td>@empleado.Puesto</td>
                        <td>
                            @Html.DisplayFor(modelItem => empleado.Turno)
                        </td>
                        <td>
                            ₡@empleado.SalarioMensual.ToString("N2")
                        </td>
                        <td>
                            @empleado.FechaIngreso.ToString("dd/MM/yyyy")
                        </td>
                        <td>
                            <div class="acciones">
                                <a class="boton boton-secundario"
                                   asp-area=""
                                   asp-controller="Empleados"
                                   asp-action="Detalles"
                                   asp-route-id="@empleado.Id"
                                   aria-label="Ver detalles del empleado @empleado.Identificacion">
                                    Ver detalles
                                </a>

                                <a class="boton boton-secundario"
                                   asp-area=""
                                   asp-controller="Empleados"
                                   asp-action="Editar"
                                   asp-route-id="@empleado.Id"
                                   aria-label="Editar el empleado @empleado.Identificacion">
                                    Editar
                                </a>

                                <a class="boton boton-peligro"
                                   asp-area=""
                                   asp-controller="Empleados"
                                   asp-action="Eliminar"
                                   asp-route-id="@empleado.Id"
                                   aria-label="Eliminar el empleado @empleado.Identificacion">
                                    Eliminar
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
