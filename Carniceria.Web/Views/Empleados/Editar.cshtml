@model EmpleadoFormulario
@* Envía los cambios del empleado asociado al Id de la ruta. *@

@{
    ViewData["Title"] = "Editar empleado";

    string? idEmpleado = ViewContext.RouteData.Values["id"]?.ToString();
}

<h1>Editar empleado</h1>

<p>
    Actualice los datos del empleado. Todos los campos son obligatorios.
</p>

@* Envía los cambios junto con el Id de la ruta y protección antifalsificación. *@
<form asp-area=""
      asp-controller="Empleados"
      asp-action="Editar"
      asp-route-id="@idEmpleado"
      method="post"
      asp-antiforgery="true"
      class="formulario"
      novalidate>

    @* Muestra los errores antes de los campos editables. *@
    <partial name="_ResumenValidacion" />

    @* Reutiliza los campos personales y laborales del empleado. *@
    <partial name="_Formulario" model="@Model" />

    @* Acciones para guardar o cancelar la edición. *@
    <div class="acciones">
        <button type="submit" class="boton">
            Guardar cambios
        </button>

        <a class="boton boton-secundario"
           asp-area=""
           asp-controller="Empleados"
           asp-action="Detalles"
           asp-route-id="@idEmpleado">
            Cancelar
        </a>
    </div>
</form>

@section Scripts {
    <script src="~/js/empleados.js"
            asp-append-version="true"></script>
}
