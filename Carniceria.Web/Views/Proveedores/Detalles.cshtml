@model RespuestaProveedor
@* Presenta los datos comerciales y de contacto del proveedor. *@

@{
    ViewData["Title"] = "Detalles del proveedor";
}

<h1>Detalles del proveedor</h1>

@* Identificación legal, datos comerciales y medios de contacto. *@
<dl class="detalle-registro">
    <div>
        <dt>Tipo de identificación</dt>
        <dd>
            @Html.DisplayFor(model => model.TipoIdentificacion)
        </dd>
    </div>

    <div>
        <dt>Identificación</dt>
        <dd>@Model.Identificacion</dd>
    </div>

    <div>
        <dt>Razón social o nombre comercial</dt>
        <dd>@Model.RazonSocial</dd>
    </div>

    <div>
        <dt>Nombre de contacto</dt>
        <dd>@Model.NombreContacto</dd>
    </div>

    <div>
        <dt>Teléfono</dt>
        <dd>@Model.Telefono</dd>
    </div>

    <div>
        <dt>Correo electrónico</dt>
        <dd>@Model.CorreoElectronico</dd>
    </div>

    <div>
        <dt>Tipo de suministro</dt>
        <dd>
            @Html.DisplayFor(model => model.TipoSuministro)
        </dd>
    </div>

    <div>
        <dt>Frecuencia de entrega</dt>
        <dd>
            @Html.DisplayFor(model => model.FrecuenciaEntrega)
        </dd>
    </div>

    <div>
        <dt>Identificador interno</dt>
        <dd>@Model.Id</dd>
    </div>
</dl>

@* Enlaces para editar, eliminar o volver al listado. *@
<div class="acciones">
    <a class="boton boton-secundario"
       asp-area=""
       asp-controller="Proveedores"
       asp-action="Editar"
       asp-route-id="@Model.Id">
        Editar proveedor
    </a>

    <a class="boton boton-peligro"
       asp-area=""
       asp-controller="Proveedores"
       asp-action="Eliminar"
       asp-route-id="@Model.Id">
        Eliminar proveedor
    </a>

    <a class="boton boton-secundario"
       asp-area=""
       asp-controller="Proveedores"
       asp-action="Index"
       asp-route-id="">
        Volver a Proveedores
    </a>
</div>
