@model IReadOnlyList<Proveedor>

@{
    ViewData["Title"] = "Proveedores";
}

<h1>Proveedores</h1>

@if (Model.Count == 0)
{
    <p class="estado-vacio">
        Todavía no hay proveedores registrados.
    </p>
}
else
{
    <div class="tabla-contenedor"
         role="region"
         aria-label="Listado de proveedores"
         tabindex="0">
        <table>
            <thead>
                <tr>
                    <th scope="col">Identificación</th>
                    <th scope="col">Razón social o nombre comercial</th>
                    <th scope="col">Nombre de contacto</th>
                    <th scope="col">Teléfono</th>
                    <th scope="col">Correo electrónico</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var proveedor in Model)
                {
                    <tr>
                        <td>@proveedor.Identificacion</td>
                        <td>@proveedor.RazonSocial</td>
                        <td>@proveedor.NombreContacto</td>
                        <td>@proveedor.Telefono</td>
                        <td>@proveedor.CorreoElectronico</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}