@model ProveedorFormulario
@* Envia los datos del nuevo proveedor al controlador. *@

@{
    ViewData["Title"] = "Registrar proveedor";
}

<h1>Registrar proveedor</h1>

<p>
    Complete los datos del proveedor. Todos los campos son obligatorios.
</p>

@* Envia el formulario con proteccion antifalsificacion. *@
<form asp-area=""
      asp-controller="Proveedores"
      asp-action="Crear"
      asp-route-id=""
      method="post"
      asp-antiforgery="true"
      class="formulario"
      novalidate>

    @* Muestra los errores antes de los campos editables. *@
    <partial name="_ResumenValidacion" />

    @* Reutiliza los campos comerciales y de contacto del proveedor. *@
    <partial name="_Formulario" model="@Model" />

    @* Acciones para guardar o cancelar el alta. *@
    <div class="acciones">
        <button type="submit" class="boton">
            Guardar proveedor
        </button>

        <a class="boton boton-secundario"
           asp-area=""
           asp-controller="Proveedores"
           asp-action="Index"
           asp-route-id="">
            Cancelar
        </a>
    </div>
</form>
