@model ProveedorFormulario
@* Envía los cambios del proveedor asociado al Id de la ruta. *@

@{
    ViewData["Title"] = "Editar proveedor";

    string? idProveedor =
        ViewContext.RouteData.Values["id"]?.ToString();
}

<h1>Editar proveedor</h1>

<p>
    Actualice los datos del proveedor. Todos los campos son obligatorios.
</p>

@* Envía los cambios junto con el Id de la ruta y protección antifalsificación. *@
<form asp-area=""
      asp-controller="Proveedores"
      asp-action="Editar"
      asp-route-id="@idProveedor"
      method="post"
      asp-antiforgery="true"
      class="formulario"
      novalidate>

    @* Muestra los errores antes de los campos editables. *@
    <partial name="_ResumenValidacion" />

    @* Reutiliza los campos comerciales y de contacto del proveedor. *@
    <partial name="_Formulario" model="@Model" />

    @* Acciones para guardar o cancelar la edición. *@
    <div class="acciones">
        <button type="submit" class="boton">
            Guardar cambios
        </button>

        <a class="boton boton-secundario"
           asp-area=""
           asp-controller="Proveedores"
           asp-action="Detalles"
           asp-route-id="@idProveedor">
            Cancelar
        </a>
    </div>
</form>
