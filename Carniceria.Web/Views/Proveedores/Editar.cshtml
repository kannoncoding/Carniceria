@model ProveedorFormulario

@{
    ViewData["Title"] = "Editar proveedor";

    string? idProveedor =
        ViewContext.RouteData.Values["id"]?.ToString();
}

<h1>Editar proveedor</h1>

<p>
    Actualice los datos del proveedor. Todos los campos son obligatorios.
</p>

<form asp-area=""
      asp-controller="Proveedores"
      asp-action="Editar"
      asp-route-id="@idProveedor"
      method="post"
      asp-antiforgery="true"
      class="formulario"
      novalidate>

    <partial name="_ResumenValidacion" />

    <partial name="_Formulario" model="@Model" />

    <div class="acciones">
        <button type="submit" class="boton">
            Guardar cambios
        </button>

        <a class="boton boton-secundario"
           asp-area=""
           asp-controller="Proveedores"
           asp-action="Detalles"
           asp-route-id="@idProveedor">
            Cancelar
        </a>
    </div>
</form>