@model ProductoFormulario
@* Envía los datos del nuevo producto al controlador. *@

@{
    ViewData["Title"] = "Registrar producto";
}

<h1>Registrar producto</h1>

<p>
    Complete los datos del producto. Todos los campos son obligatorios.
</p>

@* Envía el formulario con protección antifalsificación. *@
<form asp-area=""
      asp-controller="Productos"
      asp-action="Crear"
      asp-route-id=""
      method="post"
      asp-antiforgery="true"
      class="formulario"
      novalidate>

    @* Muestra los errores antes de los campos editables. *@
    <partial name="_ResumenValidacion" />

    @* Reutiliza los campos de producto para alta y edición. *@
    <partial name="_Formulario" model="@Model" />

    @* Acciones para guardar o cancelar el alta. *@
    <div class="acciones">
        <button type="submit" class="boton">
            Guardar producto
        </button>

        <a class="boton boton-secundario"
           asp-area=""
           asp-controller="Productos"
           asp-action="Index"
           asp-route-id="">
            Cancelar
        </a>
    </div>
</form>

@section Scripts {
    <script src="~/js/productos.js"
            asp-append-version="true"></script>
}
