@model ProductoFormulario

@{
    ViewData["Title"] = "Registrar producto";
}

<h1>Registrar producto</h1>

<p>
    Complete los datos del producto. Todos los campos son obligatorios.
</p>

<form asp-area=""
      asp-controller="Productos"
      asp-action="Crear"
      asp-route-id=""
      method="post"
      asp-antiforgery="true"
      class="formulario"
      novalidate>

    <partial name="_ResumenValidacion" />

    <partial name="_Formulario" model="@Model" />

    <div class="acciones">
        <button type="submit" class="boton">
            Guardar producto
        </button>

        <a class="boton boton-secundario"
           asp-area=""
           asp-controller="Productos"
           asp-action="Index"
           asp-route-id="">
            Cancelar
        </a>
    </div>
</form>

@section Scripts {
    <script src="~/js/productos.js"
            asp-append-version="true"></script>
}