@model Producto
@* Presenta la información y existencias del producto seleccionado. *@

@{
    ViewData["Title"] = "Detalles del producto";
}

<h1>Detalles del producto</h1>

@* Presenta el aviso que corresponde al nivel actual de existencias. *@
@if (Model.TieneExistenciaBaja)
{
    <div class="mensaje mensaje-advertencia">
        <p>
            <strong>Existencia baja.</strong>
            La existencia actual es igual o inferior a la existencia mínima.
        </p>
    </div>
}
else
{
    <div class="mensaje mensaje-exito">
        <p>
            <strong>Existencia suficiente.</strong>
            La existencia actual es superior a la existencia mínima.
        </p>
    </div>
}

@* Identificación, proveedor, precio y niveles de inventario. *@
<dl class="detalle-registro">
    <div>
        <dt>Código</dt>
        <dd>@Model.Codigo</dd>
    </div>

    <div>
        <dt>Nombre</dt>
        <dd>@Model.Nombre</dd>
    </div>

    <div>
        <dt>Categoría</dt>
        <dd>
            @Html.DisplayFor(model => model.Categoria)
        </dd>
    </div>

    <div>
        <dt>Unidad de medida</dt>
        <dd>
            @Html.DisplayFor(model => model.UnidadMedida)
        </dd>
    </div>

    <div>
        <dt>Precio por unidad de medida</dt>
        <dd>
            ₡@Model.PrecioUnidadMedida.ToString("G")
            / @Html.DisplayFor(model => model.UnidadMedida)
        </dd>
    </div>

    <div>
        <dt>Existencia actual</dt>
        <dd>
            @Model.ExistenciaActual.ToString("G")
            (@Html.DisplayFor(model => model.UnidadMedida))
        </dd>
    </div>

    <div>
        <dt>Existencia mínima</dt>
        <dd>
            @Model.ExistenciaMinima.ToString("G")
            (@Html.DisplayFor(model => model.UnidadMedida))
        </dd>
    </div>

    <div>
        <dt>Identificador interno</dt>
        <dd>@Model.Id</dd>
    </div>
</dl>

@* Enlaces para editar, eliminar o volver al listado. *@
<div class="acciones">
    <a class="boton boton-secundario"
       asp-area=""
       asp-controller="Productos"
       asp-action="Editar"
       asp-route-id="@Model.Id">
        Editar producto
    </a>

    <a class="boton boton-peligro"
       asp-area=""
       asp-controller="Productos"
       asp-action="Eliminar"
       asp-route-id="@Model.Id">
        Eliminar producto
    </a>

    <a class="boton boton-secundario"
       asp-area=""
       asp-controller="Productos"
       asp-action="Index"
       asp-route-id="">
        Volver al Inventario de Productos
    </a>
</div>
