@model IReadOnlyList<RespuestaProducto>
@* Lista productos y enlaza con sus operaciones disponibles. *@

@{
    ViewData["Title"] = "Inventario de Productos";
}

<h1>Inventario de Productos</h1>

@* Enlaces para registrar y buscar productos. *@
<div class="acciones">
    <a class="boton"
       asp-area=""
       asp-controller="Productos"
       asp-action="Crear"
       asp-route-id="">
        Registrar producto
    </a>

    <a class="boton boton-secundario"
       asp-area=""
       asp-controller="Productos"
       asp-action="Buscar"
       asp-route-id="">
        Buscar productos
    </a>
</div>

@* Alterna entre el estado vacío y la tabla de inventario. *@
@if (Model.Count == 0)
{
    <p class="estado-vacio">
        Todavía no hay productos registrados en el inventario.
    </p>
}
else
{
    <p>
        Total de productos registrados:
        <strong>@Model.Count</strong>
    </p>

    <p>
        El precio y ambas existencias corresponden a la unidad
        de medida indicada en cada fila.
    </p>

    @* Tabla de inventario con niveles y acciones por producto. *@
    <div class="tabla-contenedor"
         role="region"
         aria-label="Inventario de productos"
         tabindex="0">
        <table>
            <thead>
                <tr>
                    <th scope="col">Código</th>
                    <th scope="col">Nombre</th>
                    <th scope="col">Proveedor principal</th>
                    <th scope="col">Categoría</th>
                    <th scope="col">Unidad de medida</th>
                    <th scope="col">Precio por unidad de medida</th>
                    <th scope="col">Existencia actual</th>
                    <th scope="col">Existencia mínima</th>
                    <th scope="col">Estado</th>
                    <th scope="col">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @* Renderiza una fila por producto registrado. *@
                @foreach (var producto in Model)
                {
                    <tr>
                        <td>@producto.Codigo</td>
                        <td>@producto.Nombre</td>
                        <td>@producto.ProveedorRazonSocial (@producto.ProveedorIdentificacion)</td>
                        <td>
                            @Html.DisplayFor(modelItem => producto.Categoria)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => producto.UnidadMedida)
                        </td>
                        <td>
                            ₡@producto.PrecioUnidadMedida.ToString("G")
                        </td>
                        <td>
                            @producto.ExistenciaActual.ToString("G")
                        </td>
                        <td>
                            @producto.ExistenciaMinima.ToString("G")
                        </td>
                        <td>
                            @* Distingue existencias bajas del nivel normal. *@
                            @if (producto.TieneExistenciaBaja)
                            {
                                <strong class="estado-stock estado-stock-bajo">
                                    Existencia baja: igual o inferior al mínimo.
                                </strong>
                            }
                            else
                            {
                                <span class="estado-stock estado-stock-normal">
                                    Existencia suficiente: superior al mínimo.
                                </span>
                            }
                        </td>
                        <td>
                            <div class="acciones">
                                <a class="boton boton-secundario"
                                   asp-area=""
                                   asp-controller="Productos"
                                   asp-action="Detalles"
                                   asp-route-id="@producto.Id"
                                   aria-label="Ver detalles del producto @producto.Codigo">
                                    Ver detalles
                                </a>

                                <a class="boton boton-secundario"
                                   asp-area=""
                                   asp-controller="Productos"
                                   asp-action="Editar"
                                   asp-route-id="@producto.Id"
                                   aria-label="Editar el producto @producto.Codigo">
                                    Editar
                                </a>

                                <a class="boton boton-peligro"
                                   asp-area=""
                                   asp-controller="Productos"
                                   asp-action="Eliminar"
                                   asp-route-id="@producto.Id"
                                   aria-label="Eliminar el producto @producto.Codigo">
                                    Eliminar
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
