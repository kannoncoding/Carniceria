@model ProductoFormulario
@* Campos reutilizados en alta y edición de productos. *@

@* Código único y nombre descriptivo del producto. *@
<div class="campo">
    <label asp-for="Codigo"></label>

    <input asp-for="Codigo"
           type="text"
           class="control"
           minlength="1"
           maxlength="20"
           autocomplete="off"
           spellcheck="false"
           required
           aria-describedby="ayuda-codigo error-codigo" />

    <span id="ayuda-codigo" class="ayuda-campo">
        Entre 1 y 20 letras o números, sin espacios ni signos.
        Ejemplo: RES001. El código debe ser único entre los productos.
    </span>

    <span asp-validation-for="Codigo"
          id="error-codigo"></span>
</div>

@* Nombre comercial del producto. *@
<div class="campo">
    <label asp-for="Nombre"></label>

    <input asp-for="Nombre"
           type="text"
           class="control"
           minlength="3"
           maxlength="80"
           required
           aria-describedby="ayuda-nombre error-nombre" />

    <span id="ayuda-nombre" class="ayuda-campo">
        Entre 3 y 80 letras o números, sin espacios ni signos.
        Ejemplo: CarneMolida.
    </span>

    <span asp-validation-for="Nombre"
          id="error-nombre"></span>
</div>

@* Categoría comercial del producto. *@
<div class="campo">
    <label asp-for="Categoria"></label>

    <select asp-for="Categoria"
            asp-items="Html.GetEnumSelectList<CategoriaProducto>()"
            class="control"
            required
            aria-describedby="error-categoria">
        <option value="">Seleccione una categoría</option>
    </select>

    <span asp-validation-for="Categoria"
          id="error-categoria"></span>
</div>

@* Unidad que determina la escala del precio y las existencias. *@
<div class="campo">
    <label asp-for="UnidadMedida"></label>

    <select asp-for="UnidadMedida"
            asp-items="Html.GetEnumSelectList<UnidadMedida>()"
            class="control"
            required
            aria-describedby="ayuda-unidad-medida aviso-cambio-unidad error-unidad-medida">
        <option value="">Seleccione una unidad de medida</option>
    </select>

    <span id="ayuda-unidad-medida"
          class="ayuda-campo"
          aria-live="polite"
          aria-atomic="true">
        El precio, la existencia actual y la existencia mínima
        corresponden a la unidad de medida seleccionada.
    </span>

    <span asp-validation-for="UnidadMedida"
          id="error-unidad-medida"></span>
</div>

@* Aclara que cambiar de unidad no convierte los valores capturados. *@
<p id="aviso-cambio-unidad" class="aviso">
    <strong>Al cambiar la unidad de medida:</strong>
    revise el precio y ambas existencias.
    Los números ingresados se conservan y pasan a corresponder
    a la nueva unidad. No se realiza una conversión automática.
</p>

@* Resume el formato numérico aceptado por el model binder. *@
<p id="ayuda-decimales" class="ayuda-campo">
    Use coma para los decimales, por ejemplo: 4500,50 o 0,125.
    No escriba el símbolo ₡ ni separadores de miles en los campos numéricos.
</p>

@* Precio asociado a la unidad seleccionada. *@
<div class="campo">
    <label asp-for="PrecioUnidadMedida" id="etiqueta-precio">
        Precio por unidad de medida (₡)
    </label>

    <input asp-for="PrecioUnidadMedida"
           type="text"
           inputmode="decimal"
           asp-format="{0:G}"
           class="control"
           required
           aria-describedby="ayuda-unidad-medida ayuda-decimales ayuda-precio error-precio" />

    <span id="ayuda-precio" class="ayuda-campo">
        Monto en colones por la unidad de medida seleccionada.
        Debe ser mayor que cero.
    </span>

    <span asp-validation-for="PrecioUnidadMedida"
          id="error-precio"></span>
</div>

@* Existencia disponible y umbral mínimo de inventario. *@
<div class="campo">
    <label asp-for="ExistenciaActual" id="etiqueta-existencia-actual">
        Existencia actual
    </label>

    <input asp-for="ExistenciaActual"
           type="text"
           inputmode="decimal"
           asp-format="{0:G}"
           class="control"
           required
           aria-describedby="ayuda-unidad-medida ayuda-decimales ayuda-existencia-actual error-existencia-actual" />

    <span id="ayuda-existencia-actual" class="ayuda-campo">
        Cantidad disponible en la unidad de medida seleccionada.
        Debe ser mayor o igual que cero. Se permiten cantidades decimales.
    </span>

    <span asp-validation-for="ExistenciaActual"
          id="error-existencia-actual"></span>
</div>

@* Umbral que permite señalar niveles bajos de inventario. *@
<div class="campo">
    <label asp-for="ExistenciaMinima" id="etiqueta-existencia-minima">
        Existencia mínima
    </label>

    <input asp-for="ExistenciaMinima"
           type="text"
           inputmode="decimal"
           asp-format="{0:G}"
           class="control"
           required
           aria-describedby="ayuda-unidad-medida ayuda-decimales ayuda-existencia-minima error-existencia-minima" />

    <span id="ayuda-existencia-minima" class="ayuda-campo">
        Cantidad mínima de referencia en la unidad de medida seleccionada.
        Debe ser mayor o igual que cero. Se permiten cantidades decimales.
        Una existencia actual igual o inferior a este valor genera
        una advertencia.
    </span>

    <span asp-validation-for="ExistenciaMinima"
          id="error-existencia-minima"></span>
</div>
