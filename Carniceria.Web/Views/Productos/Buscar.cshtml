@model BusquedaViewModel<Producto>

@{
    ViewData["Title"] = "Buscar productos";
}

<h1>Buscar productos</h1>

<p>
    Busque productos por su código completo o por una parte de su nombre.
</p>

<form asp-area=""
      asp-controller="Productos"
      asp-action="Buscar"
      asp-route-id=""
      method="get"
      asp-antiforgery="false"
      class="formulario"
      novalidate>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" role="alert">
            <p>
                No se pudo realizar la búsqueda.
                Revise los siguientes errores:
            </p>
        </div>
    }

    <div class="campo">
        <label asp-for="Criterio"></label>

        <select asp-for="Criterio"
                name="criterio"
                class="control"
                required
                aria-describedby="ayuda-criterio error-criterio">
            <option value="">Seleccione un criterio de búsqueda</option>
            <option value="Codigo">Código</option>
            <option value="Nombre">Nombre del producto</option>
        </select>

        <span id="ayuda-criterio" class="ayuda-campo">
            Código busca una coincidencia exacta.
            Nombre busca todos los productos que contengan el texto ingresado.
        </span>

        <span asp-validation-for="Criterio"
              id="error-criterio"></span>
    </div>

    <div class="campo">
        <label asp-for="Consulta">Código o nombre</label>

        <input asp-for="Consulta"
               name="consulta"
               type="search"
               class="control"
               autocomplete="off"
               spellcheck="false"
               required
               aria-describedby="ayuda-consulta error-consulta" />

        <span id="ayuda-consulta" class="ayuda-campo">
            Ingrese el código completo o una parte del nombre,
            según el criterio seleccionado.
            La búsqueda no distingue entre mayúsculas y minúsculas.
        </span>

        <span asp-validation-for="Consulta"
              id="error-consulta"></span>
    </div>

    <div class="acciones">
        <button type="submit" class="boton">
            Buscar
        </button>

        <a class="boton boton-secundario"
           asp-area=""
           asp-controller="Productos"
           asp-action="Buscar"
           asp-route-id=""
           asp-route-criterio=""
           asp-route-consulta="">
            Limpiar búsqueda
        </a>

        <a class="boton boton-secundario"
           asp-area=""
           asp-controller="Productos"
           asp-action="Index"
           asp-route-id="">
            Volver al Inventario de Productos
        </a>
    </div>
</form>

@if (!Model.BusquedaRealizada && ViewData.ModelState.IsValid)
{
    <p class="estado-vacio">
        Seleccione un criterio, ingrese el texto y presione Buscar
        para consultar los productos registrados.
    </p>
}
else if (Model.BusquedaRealizada && Model.Resultados.Count == 0)
{
    <p class="estado-vacio" role="status">
        No se encontraron productos para la búsqueda por
        <strong>@(Model.Criterio == "Codigo" ? "código" : "nombre")</strong>
        con el texto <strong>@Model.Consulta</strong>.
    </p>
}
else if (Model.BusquedaRealizada)
{
    <h2>Resultados de la búsqueda</h2>

    <p>
        Criterio:
        <strong>@(Model.Criterio == "Codigo" ? "Código" : "Nombre")</strong>.
        Texto consultado:
        <strong>@Model.Consulta</strong>.
        Productos encontrados:
        <strong>@Model.Resultados.Count</strong>.
    </p>

    <p>
        El precio y ambas existencias corresponden a la unidad
        de medida indicada en cada fila.
    </p>

    <div class="tabla-contenedor"
         role="region"
         aria-label="Resultados de la búsqueda de productos"
         tabindex="0">
        <table>
            <thead>
                <tr>
                    <th scope="col">Código</th>
                    <th scope="col">Nombre</th>
                    <th scope="col">Categoría</th>
                    <th scope="col">Unidad de medida</th>
                    <th scope="col">Precio por unidad de medida</th>
                    <th scope="col">Existencia actual</th>
                    <th scope="col">Existencia mínima</th>
                    <th scope="col">Estado</th>
                    <th scope="col">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var producto in Model.Resultados)
                {
                    <tr>
                        <td>@producto.Codigo</td>
                        <td>@producto.Nombre</td>
                        <td>
                            @Html.DisplayFor(modelItem => producto.Categoria)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => producto.UnidadMedida)
                        </td>
                        <td>
                            ₡@producto.PrecioUnidadMedida.ToString("G")
                        </td>
                        <td>
                            @producto.ExistenciaActual.ToString("G")
                        </td>
                        <td>
                            @producto.ExistenciaMinima.ToString("G")
                        </td>
                        <td>
                            @if (producto.TieneExistenciaBaja)
                            {
                                <strong class="estado-stock estado-stock-bajo">
                                    Existencia baja: igual o inferior al mínimo.
                                </strong>
                            }
                            else
                            {
                                <span class="estado-stock estado-stock-normal">
                                    Existencia suficiente: superior al mínimo.
                                </span>
                            }
                        </td>
                        <td>
                            <a class="boton boton-secundario"
                               asp-area=""
                               asp-controller="Productos"
                               asp-action="Detalles"
                               asp-route-id="@producto.Id"
                               aria-label="Ver detalles del producto @producto.Codigo">
                                Ver detalles
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}